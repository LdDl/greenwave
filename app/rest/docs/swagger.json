{
    "schemes": [
        "https",
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "title": "Microservice for green waves management for traffic lights",
        "contact": {},
        "version": "1.0.0"
    },
    "basePath": "/",
    "paths": {
        "/api/greenwave/extract": {
            "post": {
                "description": "Requests the calculation of green waves for traffic lights configuration",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Reference"
                ],
                "summary": "Extract green waves",
                "parameters": [
                    {
                        "description": "Traffic lights configuration",
                        "name": "POST-body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/rest.GreenWavesRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/rest.GreenWavesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/codes.Error400"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/codes.Error500"
                        }
                    }
                }
            }
        },
        "/api/greenwave/health": {
            "get": {
                "description": "Returns a simple message indicating the microservice is running",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Get health status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/rest.HealthResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/codes.Error400"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/codes.Error500"
                        }
                    }
                }
            }
        },
        "/api/greenwave/optimize": {
            "post": {
                "description": "Requests the optimization of green waves for traffic lights configuration",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Optimize"
                ],
                "summary": "Request optimization",
                "parameters": [
                    {
                        "description": "Traffic lights configuration",
                        "name": "POST-body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/rest.OptimizeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/rest.OptimizeResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/codes.Error400"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/codes.Error500"
                        }
                    }
                }
            }
        },
        "/api/maxpressure/run": {
            "post": {
                "description": "Runs a Smoothing-MP simulation on a meso network and returns\nevaluation metrics and a synthesized signal timing proposal.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "MaxPressure"
                ],
                "summary": "Run max-pressure simulation",
                "parameters": [
                    {
                        "description": "MP simulation request",
                        "name": "POST-body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.MPRunRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.MPRunResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/codes.Error400"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/codes.Error500"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "codes.Error400": {
            "type": "object",
            "properties": {
                "Error": {
                    "description": "Error indicates the error message for bad requests.",
                    "type": "string",
                    "example": "Internal Server Error"
                }
            }
        },
        "codes.Error500": {
            "type": "object",
            "properties": {
                "Error": {
                    "description": "Error indicates the error message for internal server errors.",
                    "type": "string",
                    "example": "Internal Server Error"
                }
            }
        },
        "dto.GreenIntervalDTO": {
            "type": "object",
            "properties": {
                "end": {
                    "description": "End time of the green interval in seconds",
                    "type": "number"
                },
                "phase_idx": {
                    "description": "Phase index in which the green interval occurs",
                    "type": "integer"
                },
                "start": {
                    "description": "Start time of the green interval in seconds",
                    "type": "number"
                }
            }
        },
        "dto.GreenWaveDTO": {
            "type": "object",
            "properties": {
                "band_width": {
                    "description": "Bandwidth of the green wave in seconds.",
                    "type": "number"
                },
                "distance": {
                    "description": "Distance in meters between the two junctions.",
                    "type": "number"
                },
                "interval_jun_one": {
                    "description": "Green interval on the first junction.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.GreenIntervalDTO"
                        }
                    ]
                },
                "interval_jun_two": {
                    "description": "Green interval on the second junction.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.GreenIntervalDTO"
                        }
                    ]
                },
                "travel_time": {
                    "description": "Travel time in seconds between the two junctions.",
                    "type": "number"
                }
            }
        },
        "dto.JunctionDTO": {
            "type": "object",
            "properties": {
                "cycle": {
                    "description": "Cycle is a list of phases that define the traffic light cycle for this junction",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.PhaseDTO"
                    }
                },
                "id": {
                    "description": "Traffic light identifier",
                    "type": "integer"
                },
                "label": {
                    "description": "User defined alias",
                    "type": "string"
                },
                "offset": {
                    "description": "Offset of the cycle",
                    "type": "integer"
                },
                "point": {
                    "description": "Location of the junction",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.PointDTO"
                        }
                    ]
                },
                "total_duration": {
                    "description": "Total duration of the cycle in seconds",
                    "type": "integer"
                }
            }
        },
        "dto.PhaseDTO": {
            "type": "object",
            "properties": {
                "id": {
                    "description": "Indentifier for the phase",
                    "type": "integer"
                },
                "signal_groups": {
                    "description": "List of signal groups that define the phase (one entry per group)",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.SignalGroupDTO"
                    }
                }
            }
        },
        "dto.PointDTO": {
            "type": "object",
            "properties": {
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                }
            }
        },
        "dto.SignalDTO": {
            "type": "object",
            "properties": {
                "color": {
                    "description": "Color is the color of the signal",
                    "type": "string"
                },
                "duration": {
                    "description": "Duration is the duration of the signal in seconds.",
                    "type": "integer"
                },
                "max_duration": {
                    "description": "MaxDuration is the maximum duration for the signal in seconds. Could be used during optimizations in further researchs.",
                    "type": "integer"
                },
                "min_duration": {
                    "description": "MinDuration is the minimum duration for the signal in seconds. Could be used during optimizations in further researchs.",
                    "type": "integer"
                }
            }
        },
        "dto.ThroughGreenWaveDTO": {
            "type": "object",
            "properties": {
                "bandwidth": {
                    "description": "Bandwidth of the green wave, which is the minimum duration of the green intervals",
                    "type": "number"
                },
                "depth": {
                    "description": "Number of junctions which could be passed through",
                    "type": "integer"
                },
                "intervals": {
                    "description": "Intervals of green lights that form the green wave",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.GreenIntervalDTO"
                    }
                }
            }
        },
        "rest.GreenWavesRequest": {
            "type": "object",
            "properties": {
                "desired_speed_kmh": {
                    "description": "Desired speed in km/h for calculating green waves",
                    "type": "number"
                },
                "junctions": {
                    "description": "List of junctions with their phases and signals",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.JunctionDTO"
                    }
                },
                "direction": {
                    "type": "string",
                    "enum": [
                        "forward",
                        "bidirectional"
                    ],
                    "description": "Calculation direction. Defaults to forward. Both directions use one program and offset per junction."
                },
                "group_ids": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer"
                    },
                    "description": "Forward signal group ID keyed by junction ID. Legacy requests without a selection use group 0."
                },
                "reverse_group_ids": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer"
                    },
                    "description": "Optional reverse signal group ID keyed by junction ID. Missing entries use the forward group. Selected groups must exist in every phase."
                }
            }
        },
        "rest.GreenWavesResponse": {
            "type": "object",
            "properties": {
                "green_waves": {
                    "description": "List of segments of green waves between junctions",
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/definitions/dto.GreenWaveDTO"
                        }
                    }
                },
                "through_green_waves": {
                    "description": "List of through green waves (so they can be passed through multiple junctions)",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ThroughGreenWaveDTO"
                    }
                },
                "reverse_green_waves": {
                    "description": "Reverse direction waves, ordered from the last junction to the first; populated for bidirectional requests.",
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/definitions/dto.GreenWaveDTO"
                        }
                    }
                },
                "reverse_through_green_waves": {
                    "description": "Reverse direction waves, ordered from the last junction to the first; populated for bidirectional requests.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ThroughGreenWaveDTO"
                    }
                }
            }
        },
        "rest.HealthResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "description": "Message contains the health status message.",
                    "type": "string"
                }
            }
        },
        "rest.OptimizeRequest": {
            "type": "object",
            "properties": {
                "desired_speed_kmh": {
                    "description": "Desired speed in km/h for calculating green waves",
                    "type": "number"
                },
                "junctions": {
                    "description": "List of junctions with their phases and signals",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.JunctionDTO"
                    }
                },
                "optimizer_params": {
                    "description": "Contains parameters for the optimizer",
                    "type": "object",
                    "additionalProperties": true
                },
                "optimizer_type": {
                    "description": "Specifies which optimizer to use",
                    "type": "string"
                },
                "direction": {
                    "type": "string",
                    "enum": [
                        "forward",
                        "bidirectional"
                    ],
                    "description": "Calculation direction. Defaults to forward. Both directions use one program and offset per junction."
                },
                "group_ids": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer"
                    },
                    "description": "Forward signal group ID keyed by junction ID. Legacy requests without a selection use group 0."
                },
                "reverse_group_ids": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer"
                    },
                    "description": "Optional reverse signal group ID keyed by junction ID. Missing entries use the forward group. Selected groups must exist in every phase."
                }
            }
        },
        "rest.OptimizeResponse": {
            "type": "object",
            "properties": {
                "best_offsets": {
                    "description": "Contains the optimal offsets for each junction",
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "green_waves": {
                    "description": "List of segments of green waves between junctions considering the optimal offsets",
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/definitions/dto.GreenWaveDTO"
                        }
                    }
                },
                "optimizer_extra": {
                    "description": "Additional information about the optimization process",
                    "allOf": [
                        {
                            "$ref": "#/definitions/rest.OptimizerExtra"
                        }
                    ]
                },
                "through_green_waves": {
                    "description": "List of through green waves (so they can be passed through multiple junctions) considering the optimal offsets",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ThroughGreenWaveDTO"
                    }
                },
                "reverse_green_waves": {
                    "description": "Reverse direction waves, ordered from the last junction to the first; populated for bidirectional requests.",
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/definitions/dto.GreenWaveDTO"
                        }
                    }
                },
                "reverse_through_green_waves": {
                    "description": "Reverse direction waves, ordered from the last junction to the first; populated for bidirectional requests.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ThroughGreenWaveDTO"
                    }
                }
            }
        },
        "rest.OptimizerExtra": {
            "type": "object",
            "properties": {
                "fitness_history": {
                    "description": "Contains the fitness evolution over generations\nWill be represented in case of genetic algorithm\nEach value is the best fitness of the population in that generation",
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                }
            }
        },
        "dto.MPDemandDTO": {
            "type": "object",
            "properties": {
                "base_rates": {
                    "description": "BaseRates maps link ID to base demand intensity in veh/h. Used for type \"peak\".",
                    "type": "object",
                    "additionalProperties": {
                        "type": "number",
                        "format": "float64"
                    }
                },
                "peak_duration_s": {
                    "description": "PeakDurationS is the peak phase duration in seconds. Used for type \"peak\".",
                    "type": "number"
                },
                "peak_factor": {
                    "description": "PeakFactor is the demand multiplier at peak. Defaults to 1.3 when 0. Used for type \"peak\".",
                    "type": "number"
                },
                "ramp_down_s": {
                    "description": "RampDownS is the ramp-down phase duration in seconds. Used for type \"peak\".",
                    "type": "number"
                },
                "ramp_up_s": {
                    "description": "RampUpS is the ramp-up phase duration in seconds. Used for type \"peak\".",
                    "type": "number"
                },
                "rates": {
                    "description": "Rates maps link ID to constant demand intensity in veh/h. Used for type \"constant\".",
                    "type": "object",
                    "additionalProperties": {
                        "type": "number",
                        "format": "float64"
                    }
                },
                "type": {
                    "description": "Type is the demand model: \"constant\" or \"peak\".",
                    "type": "string"
                }
            }
        },
        "dto.MPDrainDTO": {
            "type": "object",
            "properties": {
                "rates": {
                    "description": "Rates maps link ID to drain intensity in veh/h. Used for type \"rate\".",
                    "type": "object",
                    "additionalProperties": {
                        "type": "number",
                        "format": "float64"
                    }
                },
                "type": {
                    "description": "Type is the drain model: \"auto\", \"none\", or \"rate\".",
                    "type": "string"
                }
            }
        },
        "dto.MPEvaluationDTO": {
            "type": "object",
            "properties": {
                "per_intersection": {
                    "description": "PerIntersection contains per-intersection stage selection statistics.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.MPIntersectionStatsDTO"
                    }
                },
                "per_link": {
                    "description": "PerLink contains per-link queue statistics (road segments only).",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.MPLinkStatsDTO"
                    }
                },
                "total_delay_veh_s": {
                    "description": "TotalDelayVehS is the total accumulated queue (veh * s) summed over all road\nlinks and all simulation steps (sum of queue_i * delta_t at each step).",
                    "type": "number"
                }
            }
        },
        "dto.MPIntersectionConfigDTO": {
            "type": "object",
            "properties": {
                "group_connectors": {
                    "description": "GroupConnectors maps signal group ID to the meso connector link IDs it controls.\nJSON keys are group IDs as strings (e.g. \"0\", \"1\").",
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    }
                },
                "junction": {
                    "description": "Junction is the full signal plan for this intersection.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.JunctionDTO"
                        }
                    ]
                },
                "macro_node_id": {
                    "description": "MacroNodeID is the macro-graph node ID identifying this intersection.",
                    "type": "integer"
                }
            }
        },
        "dto.MPIntersectionStatsDTO": {
            "type": "object",
            "properties": {
                "macro_node_id": {
                    "description": "MacroNodeID identifies the intersection.",
                    "type": "integer"
                },
                "stage_fractions": {
                    "description": "StageFractions maps stage ID to the fraction of steps it was selected [0, 1].\nJSON keys are stage IDs as strings.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "number",
                        "format": "float64"
                    }
                }
            }
        },
        "dto.MPLinkDTO": {
            "type": "object",
            "properties": {
                "capacity": {
                    "description": "Capacity is the saturation flow in veh/h.",
                    "type": "integer"
                },
                "id": {
                    "description": "ID is the unique link identifier.",
                    "type": "integer"
                },
                "is_connection": {
                    "description": "IsConnection marks whether this link connects two other mesoscopic links.",
                    "type": "boolean"
                },
                "lanes": {
                    "description": "Lanes is the number of lanes (road segments).",
                    "type": "integer"
                },
                "length_meters": {
                    "description": "LengthMeters is the link length in meters (road segments).",
                    "type": "number"
                },
                "macro_node": {
                    "description": "MacroNode is the parent macro-node ID (connector links only).",
                    "type": "integer"
                },
                "movement_meso_link_income": {
                    "description": "MovementMesoLinkIncome is the incoming mesoscopic link identifier (connector links only).",
                    "type": "integer"
                },
                "movement_meso_link_outcome": {
                    "description": "MovementMesoLinkOutcome is the outgoing mesoscopic link identifier (connector links only).",
                    "type": "integer"
                },
                "source_node": {
                    "description": "SourceNode is the source meso node ID.",
                    "type": "integer"
                },
                "target_node": {
                    "description": "TargetNode is the target meso node ID.",
                    "type": "integer"
                }
            }
        },
        "dto.MPLinkStatsDTO": {
            "type": "object",
            "properties": {
                "avg_queue_veh": {
                    "description": "AvgQueueVeh is the time-averaged queue length in vehicles.",
                    "type": "number"
                },
                "link_id": {
                    "description": "LinkID is the meso link identifier.",
                    "type": "integer"
                },
                "max_queue_veh": {
                    "description": "MaxQueueVeh is the peak queue length in vehicles.",
                    "type": "number"
                }
            }
        },
        "dto.MPNetworkDTO": {
            "type": "object",
            "properties": {
                "links": {
                    "description": "Links is the list of meso links (road segments and connectors).",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.MPLinkDTO"
                    }
                }
            }
        },
        "dto.MPProposalDTO": {
            "type": "object",
            "properties": {
                "junction": {
                    "description": "Junction is the updated signal plan with redistributed green times.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.JunctionDTO"
                        }
                    ]
                },
                "macro_node_id": {
                    "description": "MacroNodeID identifies the intersection.",
                    "type": "integer"
                }
            }
        },
        "dto.MPRunRequest": {
            "type": "object",
            "properties": {
                "config": {
                    "description": "Config holds simulation parameters.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.MPSimConfigDTO"
                        }
                    ]
                },
                "coordinated_corridors": {
                    "description": "CoordinatedCorridors contains directed road-link paths, each with at least\nthree links and assigned signal-controlled movements between them.\nRequired when config.alpha > 0; reverse direction needs its own path.",
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    }
                },
                "demand": {
                    "description": "Demand defines the traffic input per entry link.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.MPDemandDTO"
                        }
                    ]
                },
                "drain": {
                    "description": "Drain controls how vehicles leave the network at boundary exits.\nOmit or set type to \"auto\" for the default behaviour (zero queue each step).",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.MPDrainDTO"
                        }
                    ]
                },
                "initial_queues": {
                    "description": "InitialQueues sets starting queue length (vehicles) per link ID. Optional.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "number",
                        "format": "float64"
                    }
                },
                "intersections": {
                    "description": "Intersections defines the signal configuration and group-to-connector mapping.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.MPIntersectionConfigDTO"
                    }
                },
                "network": {
                    "description": "Network is the meso-level graph (road segments + connector links).",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.MPNetworkDTO"
                        }
                    ]
                }
            }
        },
        "dto.MPRunResponse": {
            "type": "object",
            "properties": {
                "evaluation": {
                    "description": "Evaluation contains simulation metrics measured over the full SimTime.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.MPEvaluationDTO"
                        }
                    ]
                },
                "proposal": {
                    "description": "Proposal contains re-synthesized signal timings based on MP stage fractions.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.MPProposalDTO"
                    }
                }
            }
        },
        "dto.MPSimConfigDTO": {
            "type": "object",
            "properties": {
                "alpha": {
                    "description": "Alpha scales the experimental bonus on coordinated_corridors (>= 0).\nZero disables the bonus. This is not the paper's per-step coordination weight.",
                    "type": "number"
                },
                "delta_t": {
                    "description": "DeltaT is the simulation step duration in seconds. Defaults to 5.0 if not set.",
                    "type": "number"
                },
                "sim_time": {
                    "description": "SimTime is the total simulation duration in seconds. Must be > 0.",
                    "type": "number"
                }
            }
        },
        "dto.SignalGroupDTO": {
            "type": "object",
            "properties": {
                "id": {
                    "description": "Signal group identifier",
                    "type": "integer"
                },
                "signals": {
                    "description": "List of signals that define the group's state sequence within the phase",
                    "type": "array",
